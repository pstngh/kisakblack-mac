set output dump
set bind-root false
match callExpr(callee(functionDecl(hasAnyName("memset", "memcpy", "memmove", "Com_Memset", "Com_Memcpy"))), hasArgument(0, ignoringParenCasts(expr(anyOf(hasType(pointerType(pointee(hasUnqualifiedDesugaredType(recordType())))), hasType(constantArrayType(hasElementType(hasUnqualifiedDesugaredType(recordType())))))).bind("dst"))), hasArgument(2, ignoringParenImpCasts(anyOf(integerLiteral().bind("n"), binaryOperator(hasOperatorName("*"), hasEitherOperand(ignoringParenImpCasts(integerLiteral().bind("n"))))))))
