set output dump
set bind-root false
match callExpr(callee(functionDecl(hasAnyName("memset", "memcpy", "memmove", "Com_Memset", "Com_Memcpy"))), hasArgument(0, ignoringParenImpCasts(expr(hasType(pointerType(pointee(hasUnqualifiedDesugaredType(recordType()))))).bind("dst"))), hasArgument(2, ignoringParenImpCasts(integerLiteral().bind("n"))))
